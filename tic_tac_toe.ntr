func print(text){
    __out(text,"\n");
}

func draw(board){

    print(board[0]+" | "+board[1]+" | "+board[2]);
    print("---------");
    print(board[3]+" | "+board[4]+" | "+board[5]);
    print("---------");
    print(board[6]+" | "+board[7]+" | "+board[8]);
}

func check_win(board, player){

    var lines = [
        [0,1,2],
        [3,4,5],
        [6,7,8],
        [0,3,6],
        [1,4,7],
        [2,5,8],
        [0,4,8],
        [2,4,6]
    ];


    var i = 0;

    while(i < 8){

        var line = lines[i];

        if(
            board[line[0]] == player
            &&
            board[line[1]] == player
            &&
            board[line[2]] == player
        ){
            return true;
        }

        i = i + 1;
    }

    return false;
}

func can_place(board, pos){
    if(board[pos] == " "){
        return true;
    }

    return false;
}

func ai_move(board){

    var i = 0;


   

    while(i < 9){

        if(board[i] == " "){

            board[i] = "O";

            if(check_win(board,"O")){
                return i;
            }

            board[i] = " ";
        }

        i = i + 1;
    }



   

    i = 0;

    while(i < 9){

        if(board[i] == " "){

            board[i] = "X";

            if(check_win(board,"X")){
                board[i] = "O";
                return i;
            }

            board[i] = " ";
        }

        i = i + 1;
    }




    if(board[4] == " "){
        board[4] = "O";
        return 4;
    }




    if(board[0] == " "){
        board[0] = "O";
        return 0;
    }

    if(board[2] == " "){
        board[2] = "O";
        return 2;
    }

    if(board[6] == " "){
        board[6] = "O";
        return 6;
    }

    if(board[8] == " "){
        board[8] = "O";
        return 8;
    }




    i = 0;

    while(i < 9){

        if(board[i] == " "){
            board[i] = "O";
            return i;
        }

        i = i + 1;
    }


    return -1;
}

func main(){

    var game = {
        board:[
            " "," "," ",
            " "," "," ",
            " "," "," "
        ],

        running:true,
        moves:0
    };



    while(game.running){

        draw(game.board);


        print("Choose position 1-9:");

        var pos = __cast(0,__in());

        pos = pos - 1;


        if(can_place(game.board,pos)){

            game.board[pos] = "X";
            game.moves = game.moves + 1;


            if(check_win(game.board,"X")){

                draw(game.board);
                print("You win!");
                game.running = false;
            }


            else if(game.moves >= 9){

                draw(game.board);
                print("Draw!");
                game.running = false;
            }


            else{

                var ai = ai_move(game.board);

                game.moves = game.moves + 1;


                if(check_win(game.board,"O")){

                    draw(game.board);
                    print("Computer wins!");
                    game.running = false;
                }

                else if(game.moves >= 9){

                    draw(game.board);
                    print("Draw!");
                    game.running = false;
                }
            }

        }

        else{

            print("Invalid move!");
        }
    }
}


main();